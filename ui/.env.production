# Production: the Vue app is served by the same C# server, so use relative URLs.
# Empty VITE_API_URL → fetch('/api/...') resolves to the current host automatically.
# Empty VITE_WS_URL → main.js computes ws(s)://currentHost/srv/ at runtime.
VITE_API_URL=
VITE_WS_URL=

# White-labeling: set these to replace "CRS Reporter" / "CRS" throughout the app
# (see ui/src/config/brand.js). Empty → falls back to the CRS defaults.
VITE_APP_NAME=
VITE_APP_SHORT_NAME=
